datasource db {
  provider = "mysql"
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

// User
model User {
  id         String    @id @default(cuid(2)) @db.VarChar(24)
  // 用于认证的公钥
  publicKey  Bytes     @unique @map("public_key") @db.VarBinary(128)
  // 元数据（由服务调用方设置）
  metadata   Bytes?    @db.VarBinary(2048)
  // 创建时间
  createTime DateTime  @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime DateTime  @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime DateTime? @map("delete_time") @db.Timestamp(3)
  // 是否已被禁用
  disabled   Boolean   @default(false)
  // 该用户所拥有的项目
  projects   Project[]

  @@map("user")
}

// Supervisor
model Supervisor {
  id         String    @id @default(cuid(2)) @db.VarChar(24)
  // 用于认证的公钥
  publicKey  Bytes     @unique @map("public_key") @db.VarBinary(128)
  // 元数据（由服务调用方设置）
  metadata   Bytes?    @db.VarBinary(2048)
  // 创建时间
  createTime DateTime  @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime DateTime  @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime DateTime? @map("delete_time") @db.Timestamp(3)

  @@map("supervisor")
}

// 模板状态
enum TemplateStatus {
  // 草稿
  Draft     @map("DRAFT")
  // 已发布
  Published @map("PUBLISHED")
  // 已归档
  Archived  @map("ARCHIVED")
}

// 项目模板
model Template {
  id               String         @id @default(cuid(2)) @db.VarChar(24)
  // 元数据（由服务调用方设置）
  metadata         Bytes?         @db.VarBinary(2048)
  // 模板状态
  status           TemplateStatus @default(Draft)
  // 创建时间
  createTime       DateTime       @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime       DateTime       @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime       DateTime?      @map("delete_time") @db.Timestamp(3)
  // 由当前模板 fork 出来的子模板列表
  forks            Template[]     @relation("template_forks")
  // 父模板（此模板是由哪个模板 fork 出来的）
  sourceTemplate   Template?      @relation("template_forks", fields: [sourceTemplateId], references: [id])
  // 父模板 ID
  sourceTemplateId String?        @db.VarChar(24)
  // 从该模板创建的项目
  projects         Project[]

  @@map("template")
}

// 项目资源规格
enum ProjectResourceTier {
  Minimum     @map("MINIMUM")
  Standard    @map("STANDARD")
  Performance @map("PERFORMANCE")
}

// 项目
model Project {
  id           String              @id @default(cuid(2)) @db.VarChar(24)
  // 元数据（由服务调用方设置）
  metadata     Bytes?              @db.VarBinary(2048)
  // 创建时间
  createTime   DateTime            @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime   DateTime            @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime   DateTime?           @map("delete_time") @db.Timestamp(3)
  // 为该项目所分配的资源规格
  resourceTier ProjectResourceTier @default(Minimum) @map("resource_tier")
  // 该项目的所有者 ID
  ownerId      String              @map("owner_id") @db.VarChar(24)
  // 该项目的所有者
  owner        User                @relation(fields: [ownerId], references: [id])
  // 关联的模板
  template     Template?           @relation(fields: [templateId], references: [id])
  // 关联的模板 ID
  templateId   String?             @db.VarChar(24)

  @@map("project")
}
