FROM ubuntu:26.04 AS kernel-builder

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /app

COPY ./services/supervisor/scripts .

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        bash \
        git \
        curl \
        ca-certificates \
        build-essential \
        libelf-dev \
        diffutils \
        bc \
        flex \
        bison \
        linux-libc-dev \
        libssl-dev \
        perl \
        python3 \
    && rm -rf /var/lib/apt/lists/*

RUN ./build-kernel.sh ./vmlinux

FROM node:24.20.0-alpine AS app-builder

COPY --from=golang:1.27-alpine /usr/local/go /usr/local/go

ENV PNPM_HOME="/pnpm"
ENV GOROOT="/usr/local/go"

ENV PATH="$PATH:$PNPM_HOME"
ENV PATH="$PATH:$GOROOT/bin"

RUN corepack enable

RUN apk add --no-cache git ca-certificates

WORKDIR /app

COPY . .

ENV CI=true

RUN pnpm config set registry https://registry.npmmirror.com
RUN pnpm config set store-dir /pnpm/store

RUN pnpm install --frozen-lockfile --prod=false

RUN pnpm --filter @aw/vm-director generate
RUN pnpm --filter @aw/vm-supervisor exec turbo build
RUN pnpm --filter @aw/vm-supervisor deploy /app/pruned/supervisor --prod --legacy

# runner

FROM ubuntu:26.04 AS runner

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
    && curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y --no-install-recommends \
        nodejs \
        buildah \
        crun \
        qemu-utils \
        e2fsprogs \
        squashfs-tools \
        netavark \
        iproute2 \
        nftables \
        procps \
        nfs-ganesha \
        nfs-ganesha-vfs \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /etc/containers \
    && printf '%s\n' \
        '[storage]' \
        'driver = "vfs"' \
        > /etc/containers/storage.conf

WORKDIR /app

VOLUME ["/aw-supervisor", "/aw-fs"]

ENV NODE_ENV=production

ENV AW_SUPERVISOR_DIRECTOR_HOST_URL="http://127.0.0.1:3008"
ENV AW_SUPERVISOR_FS_ROOT="/aw-fs"
ENV AW_SUPERVISOR_ID="unknown"
ENV AW_SUPERVISOR_PRIVATE_KEY="unknown"

COPY --from=app-builder /app/pruned/supervisor .
COPY --from=kernel-builder /app/vmlinux ./ci/vmlinux

CMD ["node", "./dist/index.cjs"]

# sudo docker run --rm -it --network host --privileged --entrypoint sh aw-supervisor:latest
