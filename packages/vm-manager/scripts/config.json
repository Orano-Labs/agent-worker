{
  "boot-source": {
    "kernel_image_path": "kernels/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 root=/dev/vda rw init=/init"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "alpine-rootfs.ext4",
      "is_root_device": true,
      "is_read_only": false
    }
  ],
  "machine-config": {
    "vcpu_count": 2,
    "mem_size_mib": 2048
  },
  "balloon": {
    "amount_mib": 0,
    "deflate_on_oom": true,
    "stats_polling_interval_s": 0,
    "free_page_reporting": true
  }
}
