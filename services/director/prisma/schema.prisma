datasource db {
  provider = "mysql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model User {
  id         String    @id @default(cuid(2)) @db.VarChar(24)
  // 用于认证的公钥
  publicKey  Bytes     @map("public_key") @unique @db.VarBinary(128)
  // 元数据（由服务调用方设置）
  metadata   Bytes?    @db.VarBinary(2048)
  // 创建时间
  createTime DateTime  @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime DateTime  @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime DateTime? @map("delete_time") @db.Timestamp(3)
  // 是否已被禁用
  disabled   Boolean   @default(false)
  // 该用户所拥有的项目
  projects   Project[]

  @@map("user")
}

model Supervisor {
  id         String    @id @default(cuid(2)) @db.VarChar(24)
  // 名称
  name       String    @db.VarChar(128)
  // 用于认证的公钥
  publicKey  Bytes     @map("public_key") @unique @db.VarBinary(128)
  // 元数据（由服务调用方设置）
  metadata   Bytes?    @db.VarBinary(2048)
  // 创建时间
  createTime DateTime  @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime DateTime  @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime DateTime? @map("delete_time") @db.Timestamp(3)

  @@map("supervisor")
}

// 项目资源规格
enum ProjectResourceTier {
  Minimum     @map("MINIMUM")
  Standard    @map("STANDARD")
  Performance @map("PERFORMANCE")
}

// 项目部署状态
enum ProjectDeploymentStatus {
  // 正在部署
  Pending @map("PENDING")
  // 部署成功
  Success @map("SUCCESS")
  // 部署失败
  Failed  @map("FAILED")
}

// 项目
model Project {
  id                     String                  @id @default(cuid(2)) @db.VarChar(24)
  // 项目名称
  name                   String                  @db.VarChar(128)
  // 项目描述
  description            String?                 @db.VarChar(512)
  // 创建时间
  createTime             DateTime                @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime             DateTime                @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime             DateTime?               @map("delete_time") @db.Timestamp(3)
  // 该项目下的所有会话
  sessions               Session[]
  // 为该项目所分配的资源规格
  resourceTier           ProjectResourceTier     @default(Minimum) @map("resource_tier")
  // 该项目的所有者 ID
  ownerId                String                  @map("owner_id") @db.VarChar(24)
  // 该项目的所有者
  owner                  User                    @relation(fields: [ownerId], references: [id])
  // 部署状态
  deploymentStatus       ProjectDeploymentStatus @default(Pending) @map("deployment_status")
  // 部署失败时的错误消息
  deploymentErrorMessage String?                 @map("deployment_error_message") @db.VarChar(512)

  @@map("project")
}

// 模板状态
enum TemplateStatus {
  // 草稿
  Draft     @map("DRAFT")
  // 已发布
  Published @map("PUBLISHED")
  // 已归档
  Archived  @map("ARCHIVED")
}

// 项目模板
model Template {
  id          String         @id @default(cuid(2)) @db.VarChar(24)
  // 模板名称
  name        String         @db.VarChar(128)
  // 模板描述
  description String?        @db.VarChar(512)
  // 模板状态
  status      TemplateStatus @default(Draft)
  // 创建时间
  createTime  DateTime       @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime  DateTime       @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime  DateTime?      @map("delete_time") @db.Timestamp(3)

  @@map("template")
}

// 会话
model Session {
  id         String         @id @default(cuid(2)) @db.VarChar(24)
  // 所属项目
  project    Project        @relation(fields: [projectId], references: [id])
  // 所属项目 ID
  projectId  String         @db.VarChar(24)
  // 创建时间
  createTime DateTime       @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime DateTime       @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 用户下发的任务历史
  tasks      Task[]
  // 元数据
  metadata   Json
  // 会话历史
  entries    SessionEntry[]

  @@map("session")
}

// 已存档的会话历史条目
model SessionEntry {
  id         String   @id @default(cuid(2)) @db.VarChar(24)
  // 所属会话
  session    Session  @relation(fields: [sessionId], references: [id])
  // 所属会话 ID
  sessionId  String   @map("session_id") @db.VarChar(24)
  // 原始数据
  data       Bytes
  // 创建时间
  createTime DateTime @default(now()) @map("create_time") @db.Timestamp(3)
  // 自动增长的序列号；用于准确排序数据
  sequence   Int      @unique @default(autoincrement())

  @@map("session_entry")
}

// 任务类型
enum TaskType {
  Steer
  FllowUp
}

// 任务状态
enum TaskStatus {
  // 任务正在等待被处理
  Pending
  // 任务正在执行
  Running
  // 任务执行成功
  Success
  // 任务执行失败
  Failed
  // 任务被取消
  Interrupted
}

// 用户的输入（将会作为一个任务分发）
model Task {
  id        String     @id @default(cuid(2)) @db.VarChar(24)
  // 任务类型
  type      TaskType
  // 任务状态
  status    TaskStatus
  // 该任务所属的会话
  session   Session    @relation(fields: [sessionId], references: [id])
  // 该任务所属的会话 ID
  sessionId String     @map("session_id") @db.VarChar(24)
  // 自动增长的序列号；用于准确排序数据
  sequence  Int        @unique @default(autoincrement())

  @@map("task")
}

// 一个任务的单次执行
model Run {
  id      String     @id @default(cuid(2)) @db.VarChar(24)
  // 任务的执行实例
  entries RunEntry[]

  @@map("run")
}

// 单次任务执行产生的会话历史条目
model RunEntry {
  id         String   @id @default(cuid(2)) @db.VarChar(24)
  // 任务执行实例
  run        Run      @relation(fields: [runId], references: [id])
  // 任务执行实例 ID
  runId      String   @map("run_id") @db.VarChar(24)
  // 原始数据
  data       Bytes
  // 创建事件
  createTime DateTime @default(now()) @map("create_time") @db.Timestamp(3)
  // 自动增长的序列号；用于准确排序数据
  sequence   Int      @unique @default(autoincrement())

  @@map("run_entry")
}

// 发件箱
model Outbox {
  id         String    @id @db.VarChar(36)
  // 消息主题
  topic      String    @db.VarChar(128)
  // 二进制消息体
  payload    Bytes     @db.LongBlob
  // 创建时间
  createTime DateTime  @map("create_time") @db.Timestamp(3)
  // 删除时间 （发布时间）
  deleteTime DateTime? @map("delete_time") @db.Timestamp(3)
}
