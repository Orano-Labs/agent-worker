{
  "name": "@aw/rpc",
  "version": "0.0.1",
  "description": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "biome check --write --changed",
    "format": "buf format --write && biome format --write ./",
    "typecheck": "tsc",
    "test": "vitest",
    "generate": "buf generate && drizzle-kit generate",
    "dev": "tsx src/index.ts --cwd ./",
    "start": "node ./dist/index.cjs"
  },
  "files": [
    "dist/**/*"
  ],
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.140",
    "@bufbuild/protobuf": "^2.12.0",
    "@bufbuild/protoplugin": "^2.12.0",
    "@bufbuild/protovalidate": "^1.2.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-fastify": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@connectrpc/validate": "^0.2.0",
    "@standard-schema/spec": "^1.1.0",
    "better-sqlite3": "^12.10.0",
    "catch-unknown": "^2.0.0",
    "debug": "^4.4.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "proper-lockfile": "^4.1.2",
    "simple-git": "^3.36.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "typed-binary": "^4.3.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/debug": "^4.1.13",
    "@types/proper-lockfile": "^4.1.4",
    "drizzle-kit": "^0.31.10"
  }
}
