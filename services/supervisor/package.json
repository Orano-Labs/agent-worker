{
  "name": "@aw/vm-supervisor",
  "version": "0.0.1",
  "description": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "biome check --write --changed",
    "format": "biome format --write ./src ./scripts",
    "typecheck": "tsc",
    "test": "vitest",
    "generate": "drizzle-kit generate",
    "dev": "tsx src/index.ts --env-file ./.env",
    "start": "node ./dist/index.cjs",
    "generate:firecracker": "openapi-ts -f ./firecracker.openapi.config.ts",
    "postinstall": "pnpm generate:firecracker"
  },
  "files": [
    "dist/**/*"
  ],
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.140",
    "@aw/vm-director": "workspace:*",
    "@aw/webdav": "workspace:*",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@n1ru4l/push-pull-async-iterable-iterator": "^3.2.0",
    "@orpc/client": "^1.14.3",
    "@orpc/contract": "^1.14.3",
    "@orpc/json-schema": "^1.14.3",
    "@orpc/openapi": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "@orpc/zod": "^1.14.3",
    "better-sqlite3": "^12.10.0",
    "catch-unknown": "^2.0.0",
    "consola": "^3.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "find-my-way": "^9.6.0",
    "lmdb": "^3.5.4",
    "msgpackr": "^2.0.1",
    "mysql2": "^3.22.4",
    "nanoid": "^5.1.11",
    "nanoid-dictionary": "^5.0.0",
    "neverthrow": "^8.2.0",
    "openapi-fetch": "^0.17.0",
    "orpc": "^0.1.1",
    "partysocket": "^1.1.19",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tar": "^7.5.16",
    "undici": "^7.25.0",
    "webdav-server": "^2.6.2",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10"
  }
}
