FROM node:22.18.0-alpine AS base

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

WORKDIR /app

# builder

FROM base AS builder

COPY . .

RUN pnpm install
RUN pnpm --filter @aw/vm-director--prod generate
RUN pnpm --filter @aw/vm-director--prod turbo build
RUN pnpm --filter @aw/vm-director--prod deploy /app/pruned/director --prod --legacy

FROM node:22.18.0-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

COPY --from=builder /app/pruned/director .

RUN pnpm prisma migrate deploy

CMD ["node", "./dist/index.cjs"]