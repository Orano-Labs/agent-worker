{
  "name": "@aw/vm-agent-protocol",
  "version": "0.0.1",
  "description": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "biome check --write --changed",
    "format": "buf format --write && biome format --write ./",
    "typecheck": "tsc",
    "test": "vitest",
    "generate": "buf generate"
  },
  "files": [
    "dist/**/*"
  ],
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@bufbuild/protoplugin": "^2.12.0",
    "@bufbuild/protobuf": "^2.12.0",
    "@bufbuild/protovalidate": "^1.2.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-fastify": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@connectrpc/validate": "^0.2.0",
    "fastify": "^5.8.5"
  }
}
