datasource db {
  provider = "mysql"
}

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

// User
model User {
  id         String    @id @default(cuid(2)) @db.VarChar(24)
  // 用于认证的公钥
  publicKey  Bytes     @unique @map("public_key") @db.VarBinary(128)
  // 元数据（由服务调用方设置）
  metadata   Bytes?    @db.VarBinary(2048)
  // 创建时间
  createTime DateTime  @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime DateTime  @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime DateTime? @map("delete_time") @db.Timestamp(3)
  // 是否已被禁用
  disabled   Boolean   @default(false)
  // 该用户所拥有的项目
  projects   Project[]

  @@map("user")
}

// Supervisor
model Supervisor {
  id         String     @id @default(cuid(2)) @db.VarChar(24)
  // 用于认证的公钥
  publicKey  Bytes      @unique @map("public_key") @db.VarBinary(128)
  // 元数据（由服务调用方设置）
  metadata   Bytes?     @db.VarBinary(2048)
  // 创建时间
  createTime DateTime   @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime DateTime   @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime DateTime?  @map("delete_time") @db.Timestamp(3)
  // 承接的调度记录
  dispatches Dispatch[]

  @@map("supervisor")
}

// 模板状态
enum TemplateStatus {
  // 草稿
  Draft     @map("DRAFT")
  // 已发布
  Published @map("PUBLISHED")
  // 已归档
  Archived  @map("ARCHIVED")
}

// 项目模板
model Template {
  id               String         @id @default(cuid(2)) @db.VarChar(24)
  // 元数据（由服务调用方设置）
  metadata         Bytes?         @db.VarBinary(2048)
  // 模板状态
  status           TemplateStatus @default(Draft)
  // 创建时间
  createTime       DateTime       @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime       DateTime       @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime       DateTime?      @map("delete_time") @db.Timestamp(3)
  // 由当前模板 fork 出来的子模板列表
  forks            Template[]     @relation("template_forks")
  // 父模板（此模板是由哪个模板 fork 出来的）
  sourceTemplate   Template?      @relation("template_forks", fields: [sourceTemplateId], references: [id])
  // 父模板 ID
  sourceTemplateId String?        @map("source_template_id") @db.VarChar(24)
  // 从该模板创建的项目
  projects         Project[]

  @@map("template")
}

// 项目资源规格
enum ProjectResourceTier {
  Minimum     @map("MINIMUM")
  Standard    @map("STANDARD")
  Performance @map("PERFORMANCE")
}

// 项目
model Project {
  id           String              @id @default(cuid(2)) @db.VarChar(24)
  // 元数据（由服务调用方设置）
  metadata     Bytes?              @db.VarBinary(2048)
  // 创建时间
  createTime   DateTime            @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime   DateTime            @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)
  // 删除时间
  deleteTime   DateTime?           @map("delete_time") @db.Timestamp(3)
  // 为该项目所分配的资源规格
  resourceTier ProjectResourceTier @default(Minimum) @map("resource_tier")
  // 该项目的所有者 ID
  ownerId      String              @map("owner_id") @db.VarChar(24)
  // 该项目的所有者
  owner        User                @relation(fields: [ownerId], references: [id])
  // 关联的模板
  template     Template?           @relation(fields: [templateId], references: [id])
  // 关联的模板 ID
  templateId   String?             @map("template_id") @db.VarChar(24)
  // 调度记录
  dispatches   Dispatch[]

  @@map("project")
}

// 调度状态
enum DispatchStatus {
  // 待分发
  Pending    @map("PENDING")
  // 已分发
  Dispatched @map("DISPATCHED")
  // 运行中
  Running    @map("RUNNING")
  // 已完成
  Completed  @map("COMPLETED")
  // 失败
  Failed     @map("FAILED")
}

// 调度记录
model Dispatch {
  id           String         @id @default(cuid(2)) @db.VarChar(24)
  // 关联的项目ID
  projectId    String         @map("project_id") @db.VarChar(24)
  // 关联的项目
  project      Project        @relation(fields: [projectId], references: [id])
  // 调度状态
  status       DispatchStatus @default(Pending)
  // 活跃标记；活跃记录为固定值 "active"，终态记录置 NULL（NULL 不参与唯一约束，可保留历史）
  activeKey    String?        @default("active") @map("active_key") @db.VarChar(24)
  // 承接分发的 Supervisor ID
  supervisorId String?        @map("supervisor_id") @db.VarChar(24)
  // 承接分发的 Supervisor
  supervisor   Supervisor?    @relation(fields: [supervisorId], references: [id])
  // 已尝试分发次数
  attempts     Int            @default(0)
  // 租约令牌
  leaseToken   String         @unique @default(uuid()) @map("lease_token") @db.VarChar(64)
  // 租约到期时间
  leaseUntil   DateTime       @default(now()) @map("lease_until") @db.Timestamp(3)
  // 创建时间
  createTime   DateTime       @default(now()) @map("create_time") @db.Timestamp(3)
  // 更新时间
  updateTime   DateTime       @default(now()) @updatedAt @map("update_time") @db.Timestamp(3)

  // 同一项目仅允许一条活跃调度记录；终态记录 activeKey 为 NULL
  @@unique([projectId, activeKey])
  @@index([projectId, status])
  @@index([status, leaseUntil])
  @@index([supervisorId, status])
  @@map("dispatch")
}
