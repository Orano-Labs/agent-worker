# Copy to /aw-supervisor/.env; the entrypoint loads configuration from that directory.
NODE_ENV=production
AW_SUPERVISOR_FIRECRACKER_ARTIFACTS=/app/firecracker-artifacts
AW_SUPERVISOR_RUNTIME_IMAGE=/app/image/runtime.squashfs
AW_SUPERVISOR_FS_ROOT=/aw-fs
# HTTP/RPC components are currently not activated by the demo entrypoint.
AW_SUPERVISOR_SERVER_HOST=127.0.0.1
AW_SUPERVISOR_SERVER_PORT=3000
# Reserved for Director integration (not consumed by the current entrypoint).
AW_SUPERVISOR_ID=
AW_SUPERVISOR_PRIVATE_KEY=
