{
  "name": "@aw/vm-director",
  "version": "0.0.1",
  "description": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./supervisor": {
      "types": "./dist/supervisor.d.mts",
      "import": "./dist/supervisor.mjs",
      "require": "./dist/supervisor.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "biome check --write --changed",
    "format": "biome format --write ./",
    "typecheck": "tsc",
    "test": "vitest",
    "generate": "drizzle-kit generate",
    "dev": "NODE_EXTRA_CA_CERTS=\"$(mkcert -CAROOT)/rootCA.pem\" tsx watch --include \"./src/**/*\" src/index.ts --env-file ./.env",
    "start": "node ./dist/index.cjs"
  },
  "files": [
    "dist/**/*"
  ],
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.140",
    "@bufbuild/protobuf": "^2.12.0",
    "@bufbuild/protovalidate": "^1.2.0",
    "@cloudamqp/amqp-client": "^4.0.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@connectrpc/validate": "^0.2.0",
    "@earendil-works/pi-coding-agent": "^0.80.2",
    "@orpc/client": "^1.14.3",
    "@orpc/contract": "^1.14.3",
    "@orpc/json-schema": "^1.14.3",
    "@orpc/openapi": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "@orpc/zod": "^1.14.3",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.10.0",
    "catch-unknown": "^2.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "find-my-way": "^9.6.0",
    "msgpackr": "^2.0.1",
    "mysql2": "^3.22.4",
    "neverthrow": "^8.2.0",
    "openapi-fetch": "^0.17.0",
    "orpc": "^0.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "selfsigned": "^5.5.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.12.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "buf": "^0.1.1",
    "drizzle-kit": "^0.31.10",
    "openapi-typescript": "^7.13.0",
    "prisma": "^7.8.0"
  }
