{
  "name": "@aw/vm-director",
  "version": "0.0.1",
  "description": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "type": "module",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./sdk": {
      "types": "./dist/sdk.d.mts",
      "import": "./dist/sdk.mjs",
      "require": "./dist/sdk.cjs"
    },
    "./tunnel": {
      "types": "./dist/tunnel.d.mts",
      "import": "./dist/tunnel.mjs",
      "require": "./dist/tunnel.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "biome check --write --changed",
    "format": "biome format --write ./",
    "typecheck": "tsc",
    "test": "vitest",
    "generate": "prisma generate && buf generate",
    "db:generate": "drizzle-kit generate",
    "dev": "tsx watch --include \"./src/**/*\" --exclude \"./src/sdk/**/*\" src/main.ts",
    "start": "prisma migrate deploy && node ./dist/index.cjs",
    "proto:generate": "buf generate && tsx ./scripts/generate-proto-registry.ts"
  },
  "files": [
    "dist/**/*",
    "prisma/**/*",
    "proto/**/*",
    "prisma.config.ts"
  ],
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@aw/container": "workspace:*",
    "@aw/environment": "workspace:*",
    "@aw/logging": "workspace:*",
    "@aw/proto": "workspace:*",
    "@aw/proto-codegen": "workspace:*",
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protovalidate": "^1.3.0",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "@connectrpc/validate": "^0.2.0",
    "@orama/cuid2": "^2.2.3",
    "@prisma/adapter-mariadb": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@supercharge/request-ip": "^1.2.0",
    "@types/pump": "^1.1.3",
    "archiver": "^8.0.0",
    "async-lock": "^1.4.1",
    "catch-unknown": "^2.0.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "1.0.0-rc.4",
    "find-my-way": "^9.6.0",
    "http-proxy-middleware": "^4.2.0",
    "ioredis": "^5.11.1",
    "mysql2": "^3.24.6",
    "neverthrow": "^8.2.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prisma": "^7.8.0",
    "pump": "^3.0.4",
    "rou3": "^0.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "^2.16.0",
    "@bufbuild/protoplugin": "^2.16.0",
    "@types/archiver": "^8.0.0",
    "@types/async-lock": "^1.4.2",
    "change-case": "^5.4.4",
    "drizzle-kit": "1.0.0-rc.4",
    "get-port": "^7.2.0",
    "mysql-memory-server": "^1.17.0",
    "redis-memory-server": "^0.17.1",
    "tinyglobby": "^0.2.17",
    "tsx": "^4.23.13"
  }
}
