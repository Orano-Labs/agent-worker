{
  "name": "@aw/vm-supervisor",
  "version": "0.0.1",
  "description": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "biome check --write --changed",
    "format": "biome format --write ./src ./scripts",
    "typecheck": "tsc",
    "test": "vitest",
    "generate": "drizzle-kit generate",
    "dev": "tsx src/index.ts --env-file ./.env",
    "start": "node ./dist/index.cjs",
    "generate:firecracker": "openapi-ts -f ./firecracker.openapi.config.ts"
  },
  "files": [
    "dist/**/*"
  ],
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@aw/vm-director": "workspace:*",
    "@aw/webdav": "workspace:*",
    "@aw/ptyd": "workspace:*",
    "@connectrpc/connect": "^2.1.1",
    "@connectrpc/connect-node": "^2.1.1",
    "catch-unknown": "^2.0.0",
    "lmdb": "^3.5.4",
    "nanoid": "^5.1.11",
    "nanoid-dictionary": "^5.0.0",
    "neverthrow": "^8.2.0",
    "openapi-fetch": "^0.17.0",
    "orpc": "^0.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tar": "^7.5.16",
    "undici": "^7.25.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "^0.98.2"
  }
}
