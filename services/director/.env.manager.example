# Copy to .env.manager. This is only for the trusted provisioning client.
# The server must never receive this file. Rotate keys previously in Git history.
AW_MANAGER_DIRECTOR_URL=https://director.example.com/grpc
# Ed25519 PKCS#8 DER private key, hex encoded. No default is provided.
AW_MANAGER_PRIVATE_KEY=
# Optional output path, relative to services/director. Existing files are never overwritten.
AW_MANAGER_SUPERVISOR_ENV_FILE=../supervisor/.env
