{
  "name": "@aw/vm-director",
  "version": "0.0.1",
  "description": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "biome check --write --changed",
    "format": "biome format --write ./",
    "typecheck": "tsc",
    "test": "vitest",
    "generate": "drizzle-kit generate",
    "dev": "tsx watch --include \"./src/**/*\" src/index.ts",
    "start": "node ./dist/index.cjs"
  },
  "files": [
    "dist/**/*"
  ],
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.140",
    "@orpc/client": "^1.14.3",
    "@orpc/contract": "^1.14.3",
    "@orpc/json-schema": "^1.14.3",
    "@orpc/openapi": "^1.14.3",
    "@orpc/server": "^1.14.3",
    "@orpc/zod": "^1.14.3",
    "better-sqlite3": "^12.10.0",
    "catch-unknown": "^2.0.0",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "find-my-way": "^9.6.0",
    "msgpackr": "^2.0.1",
    "orpc": "^0.1.1",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/proper-lockfile": "^4.1.4",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.10"
  }
}
