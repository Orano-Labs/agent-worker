{
  "name": "@aw/proto-codegen",
  "version": "0.0.1",
  "description": "",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch",
    "lint": "biome check --write --changed",
    "format": "biome format --write ./",
    "typecheck": "tsc",
    "test": "vitest"
  },
  "files": [
    "dist/**/*"
  ],
  "bin": "./bin/proto-codegen.cjs",
  "packageManager": "pnpm@10.14.0",
  "dependencies": {
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protoplugin": "^2.16.0"
  }
}
