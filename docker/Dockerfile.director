FROM node:24.20.0-alpine AS builder

ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"

RUN corepack enable

WORKDIR /app

COPY . .

ENV CI=true

RUN pnpm install --frozen-lockfile --prod=false
RUN pnpm --filter @aw/vm-director generate
RUN pnpm --filter @aw/vm-director exec turbo build
RUN pnpm --filter @aw/vm-director deploy /app/pruned/director --prod --legacy

FROM node:24.20.0-alpine AS runner

WORKDIR /app

COPY --from=builder /app/pruned/director .

VOLUME ["/aw-fs"]

ENV NODE_ENV=production

ENV AW_DIRECTOR_FS_ROOT="/aw-fs"

# Inject AW_DIRECTOR_DATABASE_URL, AW_DIRECTOR_REDIS_URL,
# AW_DIRECTOR_DATABASE_MIGRATIONS and AW_DIRECTOR_MANAGER_PUBLIC_KEY at runtime
# with --env-file. The Director server never needs a manager private key.

CMD ["npm", "run", "start"]
